{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node --test tests/*.test.mjs && node scripts/verify-suneung-2028.mjs --course=suneung-2028-english",
  "outputDirectory": ".",
  "routes": [
    {
      "src": "/(class|learn|learn-fr|english|suneung|international-en|international-fr|emma-test)(?:\\.html)?/?",
      "dest": "/api/session?page=$1"
    },
    {
      "src": "/api/chat",
      "dest": "/api/chat-final"
    },
    {
      "handle": "filesystem"
    }
  ],
  "functions": {
    "api/session.js": {
      "includeFiles": "*.html"
    }
  }
}
