{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/build-board-ui-release.mjs",
  "outputDirectory": ".",
  "routes": [
    {
      "src": "/api/support-chat/?",
      "dest": "/api/session?support=gem-support-v1"
    },
    {
      "src": "/(class|learn|learn-fr|english|suneung|international-en|international-fr|emma-test|materials)(?:\\.html)?/?",
      "dest": "/api/session?page=$1"
    },
    {
      "src": "/api/chat",
      "dest": "/api/chat-final"
    },
    {
      "src": "/api/library-job/?",
      "dest": "/api/chat-final?gemLibrary=job-v1"
    },
    {
      "src": "/api/library-daily/?",
      "dest": "/api/chat-final?gemLibrary=daily-v1"
    },
    {
      "src": "/generated-whiteboard/(.*)",
      "dest": "/api/session?page=not-found"
    },
    {
      "src": "/whiteboard(?:\\.html)?/?",
      "dest": "/api/session?page=whiteboard"
    },
    {
      "src": "/api/whiteboard/?",
      "dest": "/api/chat-final?gemWhiteboard=v1"
    },
    {
      "src": "/science-board(?:\\.html)?/?",
      "dest": "/api/session?page=science-board"
    },
    {
      "handle": "filesystem"
    }
  ],
  "functions": {
    "api/session.js": {
      "includeFiles": "*.html",
      "maxDuration": 60
    },
    "api/review-tutor.js": {
      "maxDuration": 180
    },
    "api/chat-final.js": {
      "includeFiles": "generated-whiteboard/*.mp3",
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/library-daily",
      "schedule": "0 21 * * *"
    }
  ],
  "ignoreCommand": "node -e \"process.exit(['release/board-korean-labels-20261014','release/video-author-studio-20261025'].includes(process.env.VERCEL_GIT_COMMIT_REF)?1:0)\""
}
